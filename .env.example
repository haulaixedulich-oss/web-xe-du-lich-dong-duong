# Cloudflare Credentials
# Lấy Account ID tại: Cloudflare Dashboard -> Trang chủ / Overview (cột bên phải: Account ID)
CLOUDFLARE_ACCOUNT_ID=

# Tạo API Token tại: Cloudflare Dashboard -> My Profile -> API Tokens -> Create Token
CLOUDFLARE_API_TOKEN=

# (Tùy chọn) Tên D1 Database & R2 Bucket
# D1_DATABASE_NAME=xedongduong_db
# D1_DATABASE_ID=
# R2_BUCKET_NAME=xedongduong_media
