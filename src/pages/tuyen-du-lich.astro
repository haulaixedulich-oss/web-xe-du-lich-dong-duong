---
import Layout from '../layouts/Layout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { siteInfo, popularRoutes } from '../data/siteData.js';
---

<Layout
  title="Các Tuyến Du Lịch Phía Bắc - Nhà Xe Đông Dương"
  description="Danh sách các tuyến tour du lịch miền Bắc trọng điểm: Hà Nội City, Sân bay Nội Bài, Sapa Fansipan, Ninh Bình Tràng An, Vịnh Hạ Long, Hà Giang Mã Pí Lèng... Phục vụ chuyên nghiệp xe 29 và 45 chỗ."
  currentPath="/tuyen-du-lich"
>
  <section class="relative bg-gradient-to-r from-red-950 via-red-900 to-slate-900 text-white py-16 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-800/80 border border-red-500/30 text-amber-300 text-xs font-bold uppercase tracking-wider mb-3">
          Cung Đường Vàng Miền Bắc
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight">
          Các Tuyến Du Lịch <span class="text-amber-300">Phía Bắc</span>
        </h1>
        <p class="text-base sm:text-lg text-slate-200 mt-3 leading-relaxed">
          Nhà xe Đông Dương chuyên phục vụ các tuyến tour trọng điểm xuất phát từ Hà Nội và Sân bay Nội Bài đi các danh thắng phía Bắc. Tài xế thông thạo cung đường cao tốc và đèo dốc, thấu hiểu thói quen của đoàn khách quốc tế và khách Sài Gòn.
        </p>
      </div>
    </div>
  </section>

  <section class="py-16 sm:py-20 bg-slate-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      {popularRoutes.map((route, idx) => (
        <div class="bg-white rounded-3xl shadow-md hover:shadow-xl border border-slate-200/80 overflow-hidden transition-all duration-300">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-center">
            
            <div class={idx % 2 === 1 ? 'lg:col-span-5 relative h-72 sm:h-80 lg:h-full min-h-[300px] lg:order-2' : 'lg:col-span-5 relative h-72 sm:h-80 lg:h-full min-h-[300px] lg:order-1'}>
              <img
                src={route.image}
                alt={route.title}
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
              
              <div class="absolute top-4 left-4">
                <span class="bg-red-700 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow">
                  {route.duration}
                </span>
              </div>

              <div class="absolute bottom-4 left-4 right-4 text-white text-xs">
                <span class="text-amber-300 font-bold block">Khoảng cách di chuyển:</span>
                <span>{route.distance}</span>
              </div>
            </div>

            <div class={idx % 2 === 1 ? 'lg:col-span-7 p-6 sm:p-8 space-y-5 lg:order-1' : 'lg:col-span-7 p-6 sm:p-8 space-y-5 lg:order-2'}>
              
              <div>
                <div class="inline-block bg-red-100 text-red-800 text-xs font-bold px-2.5 py-1 rounded-md mb-2">
                  ★ Khách chuộng: {route.targetMarket}
                </div>
                <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
                  {route.title}
                </h2>
              </div>

              <div class="flex flex-wrap gap-2 text-xs font-semibold text-slate-700">
                <span class="bg-slate-100 px-3 py-1 rounded-lg">
                  Phương tiện tối ưu: <strong class="text-red-700">{route.vehicleTypes}</strong>
                </span>
                <span class="bg-slate-100 px-3 py-1 rounded-lg">
                  Thời lượng đề xuất: <strong class="text-slate-900">{route.duration}</strong>
                </span>
              </div>

              <div>
                <h3 class="text-xs font-bold text-slate-900 uppercase tracking-wider mb-2.5">
                  Lịch Trình & Điểm Trải Nghiệm Tiêu Biểu:
                </h3>
                <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs sm:text-sm text-slate-600">
                  {route.highlights.map((hl) => (
                    <li class="flex items-start gap-2">
                      <span class="text-red-600 font-bold mt-0.5">✓</span>
                      <span>{hl}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="p-3.5 bg-red-50/70 border border-red-100 rounded-xl text-xs text-slate-700">
                <strong class="text-red-700">Ưu thế Nhà xe Đông Dương:</strong> Tài xế dày dạn kinh nghiệm cung đường, chuẩn bị nước khoáng, khăn lạnh, điểm dừng nghỉ sạch sẽ tiện nghi phù hợp với tiêu chuẩn khách quốc tế.
              </div>

              <div class="pt-2 flex flex-wrap gap-3">
                <a
                  href="/lien-he"
                  class="bg-red-600 hover:bg-red-700 text-white font-bold text-xs sm:text-sm px-5 py-2.5 rounded-xl shadow-luxury transition-all"
                >
                  Nhận Báo Giá Tuyến Này
                </a>
                <a
                  href={siteInfo.hotlineFormatted}
                  class="bg-slate-900 hover:bg-slate-800 text-white font-bold text-xs sm:text-sm px-5 py-2.5 rounded-xl transition-all"
                >
                  Tư Vấn Nhanh: {siteInfo.hotline}
                </a>
              </div>

            </div>

          </div>
        </div>
      ))}

    </div>
  </section>

  <section class="py-16 bg-white border-t border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold text-red-700 uppercase tracking-widest bg-red-50 px-3 py-1 rounded-full border border-red-200 inline-block mb-2">
          Chương Trình Tour Phổ Biến
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900">
          Các Combo Lịch Trình Tour Lữ Hành Thường Thuê Xe
        </h2>
        <p class="text-sm text-slate-600 mt-2">
          Gợi ý các hành trình kinh điển được các đối tác lữ hành inbound và đoàn khách Sài Gòn đặt thuê xe nhiều nhất tại Đông Dương Travel:
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-sm">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-red-300 transition-all">
          <div class="text-red-700 font-black text-base mb-1">Tour Di Sản & Nghỉ Dưỡng</div>
          <h3 class="font-bold text-slate-900 text-lg mb-2">Hà Nội - Ninh Bình - Hạ Long (4N3Đ)</h3>
          <p class="text-xs text-slate-600 mb-4">Lộ trình cao tốc 100% êm ái, thích hợp khách Pháp, Nhật, Thái Lan và đoàn người cao tuổi.</p>
          <div class="text-xs text-slate-500 space-y-1 border-t border-slate-200 pt-3">
            <div>• Ngày 1: Đón Nội Bài - Hà Nội City</div>
            <div>• Ngày 2: Hà Nội - Tràng An Ninh Bình</div>
            <div>• Ngày 3: Ninh Bình - Vịnh Hạ Long</div>
            <div>• Ngày 4: Hạ Long - Tiễn Sân Bay Nội Bài</div>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-red-300 transition-all">
          <div class="text-red-700 font-black text-base mb-1">Tour Chinh Phục Núi Rừng</div>
          <h3 class="font-bold text-slate-900 text-lg mb-2">Hà Nội - Sapa Fansipan (3N2Đ)</h3>
          <p class="text-xs text-slate-600 mb-4">Đoàn khách Thái Lan, Hàn Quốc, khách đoàn Sài Gòn mê săn mây và khí hậu se lạnh.</p>
          <div class="text-xs text-slate-500 space-y-1 border-t border-slate-200 pt-3">
            <div>• Ngày 1: Nội Bài / Hà Nội - Cao tốc Lào Cai - Sapa</div>
            <div>• Ngày 2: Chinh phục Fansipan - Bản Cát Cát</div>
            <div>• Ngày 3: Chợ Sapa - Khởi hành về lại Hà Nội</div>
          </div>
        </div>

        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200 hover:border-red-300 transition-all">
          <div class="text-red-700 font-black text-base mb-1">Tour Kỳ Vĩ Đông Bắc</div>
          <h3 class="font-bold text-slate-900 text-lg mb-2">Hà Nội - Hà Giang - Đồng Văn (4N3Đ)</h3>
          <p class="text-xs text-slate-600 mb-4">Xe 29 chỗ đời mới động cơ khỏe vượt đèo Mã Pí Lèng, sông Nho Quế, Cột cờ Lũng Cú.</p>
          <div class="text-xs text-slate-500 space-y-1 border-t border-slate-200 pt-3">
            <div>• Ngày 1: Hà Nội - TP. Hà Giang - Quản Bạ</div>
            <div>• Ngày 2: Yên Minh - Nhà Pao - Đồng Văn</div>
            <div>• Ngày 3: Đèo Mã Pí Lèng - Du thuyền Sông Nho Quế</div>
            <div>• Ngày 4: Hà Giang về lại Hà Nội / Nội Bài</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-16 bg-slate-100">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <QuoteForm />
    </div>
  </section>
</Layout>
