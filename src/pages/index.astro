---
import Layout from '../layouts/Layout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import { siteInfo, targetMarkets, fleetVehicles, popularRoutes, b2bBenefits } from '../data/siteData.js';
---

<Layout
  title="Nhà Xe Đông Dương - Cho Thuê Xe Du Lịch 29 Chỗ & 45 Chỗ Tuyến Phía Bắc"
  description="Đông Dương Travel (xedongduong.com) chuyên cho thuê xe 29 chỗ & 45 chỗ đời mới chạy tuyến phía Bắc: Hà Nội, Sapa, Ninh Bình, Hạ Long, Hà Giang... Chuyên phục vụ khách Thái Lan, Pháp, Nhật Bản, Hàn Quốc, Đài Loan, Sài Gòn và kết nối đối tác lữ hành."
  currentPath="/"
>
  <!-- 1. HERO SECTION -->
  <section class="relative bg-slate-900 text-white overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img
        src="/images/vehicles/doi-xe-1.jpg"
        alt="Đội xe du lịch Đông Dương Travel"
        class="w-full h-full object-cover opacity-30 scale-105"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-red-950/95 via-red-900/90 to-slate-900/85"></div>
    </div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-24 lg:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6">
          
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-800/80 border border-red-500/30 text-amber-300 text-xs sm:text-sm font-bold shadow-lg">
            <span class="flex h-2 w-2 relative">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-amber-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-amber-500"></span>
            </span>
            <span>NHÀ XE ĐÔNG DƯƠNG • ĐÔNG DƯƠNG TRAVEL</span>
          </div>

          <h1 class="text-3xl sm:text-5xl xl:text-6xl font-black text-white tracking-tight leading-tight">
            Chuyên Cho Thuê Xe <br class="hidden sm:inline" />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-300 via-yellow-200 to-amber-400">
              29 Chỗ & 45 Chỗ
            </span> <br class="hidden sm:inline" />
            Tuyến Du Lịch Phía Bắc
          </h1>

          <p class="text-base sm:text-lg text-slate-200 leading-relaxed max-w-2xl">
            Đội xe đời mới 100% bầu hơi êm ái chuyên phục vụ các cung đường: <strong>Hà Nội, Sapa, Ninh Bình, Hạ Long, Hà Giang...</strong> Đồng hành tin cậy của các <strong>đối tác lữ hành</strong> và chuyên phục vụ du khách <strong>Thái Lan, Pháp, Nhật Bản, Hàn Quốc, Đài Loan & Sài Gòn</strong>.
          </p>

          <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 pt-2 text-xs font-semibold">
            <div class="bg-white/10 backdrop-blur-sm border border-white/10 p-3 rounded-xl flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-lg bg-red-600 flex items-center justify-center flex-shrink-0 text-amber-300 font-bold">✓</div>
              <span>Xe 100% Đời Mới Bầu Hơi Êm Ái</span>
            </div>
            <div class="bg-white/10 backdrop-blur-sm border border-white/10 p-3 rounded-xl flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-lg bg-red-600 flex items-center justify-center flex-shrink-0 text-amber-300 font-bold">✈</div>
              <span>Đón Tiễn Sân Bay Nội Bài 24/7</span>
            </div>
            <div class="bg-white/10 backdrop-blur-sm border border-white/10 p-3 rounded-xl flex items-center gap-2.5 col-span-2 sm:col-span-1">
              <div class="w-7 h-7 rounded-lg bg-red-600 flex items-center justify-center flex-shrink-0 text-amber-300 font-bold">🤝</div>
              <span>Bảo Lưu Giá B2B Lữ Hành Ổn Định</span>
            </div>
          </div>

          <div class="flex flex-wrap gap-4 pt-4">
            <a
              href="#bao-gia"
              class="inline-flex items-center justify-center gap-2 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 text-white font-bold px-7 py-3.5 rounded-xl shadow-luxury hover:shadow-luxury-lg transform hover:-translate-y-0.5 transition-all text-sm sm:text-base"
            >
              <svg class="w-5 h-5 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
              </svg>
              <span>Yêu Cầu Báo Giá Nhanh</span>
            </a>

            <a
              href="/dong-xe"
              class="inline-flex items-center justify-center gap-2 bg-white/15 hover:bg-white/25 text-white font-bold px-6 py-3.5 rounded-xl backdrop-blur-sm border border-white/20 transition-all text-sm sm:text-base"
            >
              <span>Xem Đội Xe 29 & 45 Chỗ</span>
              <svg class="w-4 h-4 text-amber-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>

        </div>

        <div id="bao-gia" class="lg:col-span-5">
          <QuoteForm />
        </div>

      </div>
    </div>
  </section>

  <!-- 2. THỊ TRƯỜNG PHỤC VỤ -->
  <section class="py-16 bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold text-red-700 uppercase tracking-widest bg-red-50 px-3 py-1 rounded-full border border-red-200 inline-block mb-2">
          Kinh Nghiệm Phục Vụ Chuyên Biệt
        </span>
        <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">
          Dòng Khách Quốc Tế & Nội Địa Trọng Điểm
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2">
          Đội ngũ tài xế Nhà xe Đông Dương được đào tạo bài bản, am hiểu sâu sắc thói quen di chuyển, văn hóa và phong cách phục vụ của từng thị trường khách hàng.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {targetMarkets.map((market) => (
          <div class="bg-slate-50 hover:bg-red-50/50 rounded-2xl p-6 border border-slate-200 hover:border-red-300 shadow-sm hover:shadow-md transition-all duration-300 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="flex items-center gap-3">
                  <span class="text-3xl filter drop-shadow-sm">{market.flag}</span>
                  <h3 class="text-lg font-bold text-slate-900">{market.country}</h3>
                </div>
                <span class="text-xs font-black text-red-600 bg-red-100 px-2.5 py-0.5 rounded-full">
                  {market.code}
                </span>
              </div>
              <p class="text-sm text-slate-600 leading-relaxed">
                {market.desc}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-slate-200/80 flex items-center justify-between text-xs font-semibold text-red-700">
              <span>Chuẩn mực tour quốc tế</span>
              <span>✓ Tài xế nhiệt tình</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. CÁC DÒNG XE -->
  <section class="py-16 sm:py-20 bg-slate-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="text-xs font-bold text-red-700 uppercase tracking-widest bg-red-100 px-3 py-1 rounded-full inline-block mb-2">
            Đội Xe Đông Dương Travel
          </span>
          <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
            Hai Dòng Xe Du Lịch Chủ Lực
          </h2>
          <p class="text-sm sm:text-base text-slate-600 mt-1 max-w-xl">
            Chuyên tâm tập trung vào 2 phân khúc xe phục vụ tour lữ hành: 29 chỗ vượt đèo êm ái và 45 chỗ Universe VIP chuyên cơ mặt đất.
          </p>
        </div>

        <a
          href="/dong-xe"
          class="inline-flex items-center gap-2 text-sm font-bold text-red-700 hover:text-red-800 transition-colors"
        >
          <span>Xem chi tiết thông số kỹ thuật</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
        {fleetVehicles.map((vehicle) => (
          <div class="bg-white rounded-3xl overflow-hidden shadow-lg border border-slate-200/80 hover:shadow-xl hover:border-red-300 transition-all flex flex-col">
            
            <div class="relative h-64 sm:h-72 w-full overflow-hidden">
              <img
                src={vehicle.image}
                alt={vehicle.name}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>
              
              <div class="absolute top-4 left-4">
                <span class="bg-red-600 text-white text-xs font-bold px-3 py-1.5 rounded-full shadow-md uppercase tracking-wider">
                  {vehicle.tag}
                </span>
              </div>

              <div class="absolute bottom-4 left-4 right-4">
                <span class="text-xs text-amber-300 font-semibold block">{vehicle.models}</span>
                <h3 class="text-xl sm:text-2xl font-black text-white">{vehicle.name}</h3>
              </div>
            </div>

            <div class="p-6 sm:p-8 flex-grow flex flex-col justify-between space-y-6">
              <div>
                <div class="flex flex-wrap gap-2 text-xs font-bold text-slate-700 mb-4">
                  <span class="bg-red-50 text-red-700 px-3 py-1 rounded-lg border border-red-100">
                    {vehicle.capacity}
                  </span>
                  <span class="bg-slate-100 text-slate-700 px-3 py-1 rounded-lg">
                    {vehicle.idealGroup}
                  </span>
                </div>

                <p class="text-sm text-slate-600 leading-relaxed mb-6">
                  {vehicle.description}
                </p>

                <div class="space-y-2.5">
                  <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider">
                    Trang Bị & Tiện Nghi Nổi Bật:
                  </h4>
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs text-slate-700">
                    {vehicle.features.slice(0, 6).map((feat) => (
                      <li class="flex items-start gap-2">
                        <svg class="w-4 h-4 text-red-600 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                        </svg>
                        <span>{feat}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <div class="pt-6 border-t border-slate-100 flex items-center justify-between">
                <div>
                  <span class="text-xs text-slate-500 block">Lộ trình khuyến nghị:</span>
                  <span class="text-xs font-semibold text-slate-800">{vehicle.recommendedFor}</span>
                </div>
                <a
                  href="/dong-xe"
                  class="bg-red-600 hover:bg-red-700 text-white text-xs sm:text-sm font-bold px-4 py-2.5 rounded-xl transition-colors whitespace-nowrap ml-4"
                >
                  Xem Ảnh & Chi Tiết
                </a>
              </div>

            </div>

          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- 4. TUYẾN DU LỊCH PHÍA BẮC -->
  <section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-12">
        <span class="text-xs font-bold text-red-700 uppercase tracking-widest bg-red-50 px-3 py-1 rounded-full border border-red-200 inline-block mb-2">
          Cung Đường Thế Mạnh
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-slate-900 tracking-tight">
          Các Tuyến Du Lịch Phía Bắc Nhà Xe Đông Dương Nhận Chạy
        </h2>
        <p class="text-sm sm:text-base text-slate-600 mt-2">
          Khởi hành từ Hà Nội / Sân bay Nội Bài đi các danh lam thắng cảnh miền Bắc, kinh nghiệm chạy tour dẻo dai, phục vụ chu đáo mọi nhu cầu của đoàn.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {popularRoutes.slice(0, 6).map((route) => (
          <div class="bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-xl border border-slate-200 hover:border-red-300 transition-all duration-300 flex flex-col">
            
            <div class="relative h-48 w-full overflow-hidden">
              <img
                src={route.image}
                alt={route.title}
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
              
              <div class="absolute top-3 left-3">
                <span class="bg-red-700 text-white text-[11px] font-bold px-2.5 py-1 rounded-md shadow">
                  {route.duration}
                </span>
              </div>

              <div class="absolute bottom-3 left-3 right-3">
                <span class="text-xs text-amber-300 font-semibold block">Khoảng cách: {route.distance}</span>
              </div>
            </div>

            <div class="p-5 flex-grow flex flex-col justify-between space-y-4">
              <div>
                <h3 class="text-base font-bold text-slate-900 hover:text-red-700 transition-colors">
                  {route.title}
                </h3>
                
                <div class="mt-2 text-xs font-semibold text-red-600 bg-red-50 p-2 rounded-lg">
                  ★ {route.targetMarket}
                </div>

                <ul class="mt-3 space-y-1.5 text-xs text-slate-600">
                  {route.highlights.slice(0, 3).map((hl) => (
                    <li class="flex items-start gap-1.5">
                      <span class="text-red-500 font-bold">•</span>
                      <span>{hl}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                <span class="text-slate-500 font-medium">Loại xe: <strong>{route.vehicleTypes}</strong></span>
                <a href="/tuyen-du-lich" class="text-red-600 font-bold hover:underline">
                  Chi tiết tuyến →
                </a>
              </div>
            </div>

          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a
          href="/tuyen-du-lich"
          class="inline-flex items-center gap-2 bg-slate-900 hover:bg-slate-800 text-white font-bold px-8 py-3.5 rounded-xl shadow transition-all text-sm"
        >
          <span>Khám Phá Toàn Bộ Tuyến Phía Bắc & Điểm Đón Trả</span>
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- 5. B2B PARTNERSHIP -->
  <section class="py-16 sm:py-20 bg-gradient-to-br from-red-950 via-red-900 to-slate-950 text-white relative overflow-hidden">
    <div class="absolute -right-20 -bottom-20 w-96 h-96 rounded-full bg-red-600/20 blur-3xl pointer-events-none"></div>
    <div class="absolute -left-20 -top-20 w-96 h-96 rounded-full bg-amber-500/10 blur-3xl pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-red-800/80 border border-red-500/40 text-amber-300 text-xs font-bold uppercase tracking-wider mb-3">
          Hợp Tác Bền Vững - Phát Triển Cùng Nhau
        </div>
        <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
          Rất Mong Muốn Kết Nối Cùng Các Đối Tác Lữ Hành
        </h2>
        <p class="text-sm sm:text-base text-slate-300 mt-3">
          Nhà xe Đông Dương luôn sẵn sàng mở rộng hợp tác toàn diện với các Công ty Du lịch, Đơn vị Lữ hành Inbound & Outbound, Trưởng đoàn tour đón khách quốc tế và các tour miền Bắc xuất phát từ Sài Gòn.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
        {b2bBenefits.map((b, idx) => (
          <div class="bg-white/10 backdrop-blur-md border border-white/10 rounded-2xl p-6 hover:bg-white/15 transition-all duration-300">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-amber-500 to-yellow-400 text-slate-950 font-black flex items-center justify-center mb-4 shadow-lg text-sm">
              0{idx + 1}
            </div>
            <h3 class="text-lg font-bold text-amber-300 mb-2">
              {b.title}
            </h3>
            <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">
              {b.desc}
            </p>
          </div>
        ))}
      </div>

      <div class="bg-gradient-to-r from-red-800/90 to-red-700/90 rounded-2xl p-8 border border-red-500/40 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
        <div class="space-y-2">
          <h3 class="text-xl sm:text-2xl font-black text-white">
            Quý Công Ty Lữ Hành Cần Bảng Báo Giá Đại Lý B2B?
          </h3>
          <p class="text-xs sm:text-sm text-red-100">
            Hãy liên hệ trực tiếp hotline hoặc để lại thông tin, điều hành xe Đông Dương sẽ gửi bảng giá đại lý ưu đãi nhất.
          </p>
        </div>
        <div class="flex flex-wrap gap-3 justify-center">
          <a
            href={siteInfo.hotlineFormatted}
            class="inline-flex items-center gap-2 bg-amber-400 hover:bg-amber-300 text-slate-950 font-black text-sm px-6 py-3.5 rounded-xl shadow-lg transition-colors"
          >
            <svg class="w-4 h-4 text-red-700" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
            </svg>
            <span>Hotline B2B: {siteInfo.hotline}</span>
          </a>
          <a
            href="/lien-he"
            class="inline-flex items-center gap-2 bg-white/20 hover:bg-white/30 text-white font-bold text-sm px-6 py-3.5 rounded-xl transition-colors border border-white/20"
          >
            <span>Gửi Yêu Cầu Hợp Tác</span>
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- 6. CAM KẾT -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 text-center">
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
          <div class="text-3xl font-black text-red-600 mb-1">100%</div>
          <div class="text-sm font-bold text-slate-900">Xe Đời Mới Bầu Hơi</div>
          <p class="text-xs text-slate-500 mt-1">Không gian thoáng đãng, máy lạnh sâu, không mùi xe</p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
          <div class="text-3xl font-black text-red-600 mb-1">24/7</div>
          <div class="text-sm font-bold text-slate-900">Đón Tiễn Sân Bay Nội Bài</div>
          <p class="text-xs text-slate-500 mt-1">Đúng giờ từng phút, hỗ trợ hành lý chu đáo</p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
          <div class="text-3xl font-black text-red-600 mb-1">6 Quốc Gia</div>
          <div class="text-sm font-bold text-slate-900">Kinh Nghiệm Phục Vụ Đoàn</div>
          <p class="text-xs text-slate-500 mt-1">Thái Lan, Pháp, Nhật Bản, Hàn Quốc, Đài Loan, Sài Gòn</p>
        </div>
        <div class="p-6 rounded-2xl bg-slate-50 border border-slate-200">
          <div class="text-3xl font-black text-red-600 mb-1">VAT 100%</div>
          <div class="text-sm font-bold text-slate-900">Hóa Đơn & Hợp Đồng B2B</div>
