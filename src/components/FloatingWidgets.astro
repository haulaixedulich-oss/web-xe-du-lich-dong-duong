---
import { siteInfo } from '../data/siteData.js';
---

<div class="fixed bottom-6 right-5 z-40 flex flex-col items-center gap-3">
  
  <!-- Nút WhatsApp -->
  <a
    href={siteInfo.whatsapp}
    target="_blank"
    rel="noopener"
    class="group relative w-12 h-12 rounded-full bg-emerald-500 hover:bg-emerald-600 text-white flex items-center justify-center shadow-lg transition-transform hover:scale-110"
    aria-label="Chat WhatsApp với Đông Dương Travel"
    title="Chat WhatsApp"
  >
    <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
      <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.698c.969.588 1.961.916 3.125.917 3.181 0 5.768-2.587 5.768-5.766 0-3.18-2.587-5.766-5.768-5.766zm7.253 5.766c0 3.996-3.257 7.253-7.253 7.253-1.282 0-2.483-.34-3.535-.935l-4.496 1.179 1.2-4.382c-.689-1.121-1.076-2.433-1.076-3.834 0-3.996 3.257-7.254 7.253-7.254 3.996 0 7.253 3.258 7.253 7.254z"/>
    </svg>
    <span class="absolute right-14 bg-slate-900 text-white text-xs font-semibold py-1 px-2.5 rounded shadow whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity">
      WhatsApp Inbound
    </span>
  </a>

  <!-- Nút Zalo -->
  <a
    href={siteInfo.zalo}
    target="_blank"
    rel="noopener"
    class="group relative w-12 h-12 rounded-full bg-blue-600 hover:bg-blue-700 text-white flex items-center justify-center shadow-lg transition-transform hover:scale-110"
    aria-label="Chat Zalo với Nhà xe Đông Dương"
    title="Chat Zalo Báo Giá"
  >
    <span class="text-xs font-black tracking-tighter">Zalo</span>
    <span class="absolute right-14 bg-slate-900 text-white text-xs font-semibold py-1 px-2.5 rounded shadow whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity">
      Zalo Báo Giá 24/7
    </span>
  </a>

  <!-- Nút Hotline Gọi Điện Rực Rỡ -->
  <a
    href={siteInfo.hotlineFormatted}
    class="group relative w-14 h-14 rounded-full bg-gradient-to-tr from-red-700 to-red-600 hover:from-red-600 hover:to-red-500 text-white flex items-center justify-center shadow-2xl transition-transform hover:scale-110"
    aria-label="Gọi điện thoại hotline"
    title="Gọi Hotline"
  >
    <span class="absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75 animate-ping"></span>
    
    <svg class="relative w-7 h-7 text-amber-300" fill="currentColor" viewBox="0 0 20 20">
      <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
    </svg>
    <span class="absolute right-16 bg-red-700 text-amber-200 text-xs font-bold py-1.5 px-3 rounded-lg shadow-lg whitespace-nowrap opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity">
      Gọi ngay: {siteInfo.hotline}
    </span>
  </a>

  <!-- Nút Cuộn Lên Đầu Trang -->
  <button
    id="back-to-top"
    class="w-9 h-9 rounded-full bg-slate-800/80 hover:bg-slate-900 text-slate-300 hover:text-white flex items-center justify-center shadow opacity-0 pointer-events-none transition-all duration-300"
    aria-label="Lên đầu trang"
    title="Lên đầu trang"
  >
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
    </svg>
  </button>

</div>

<script>
  const backToTopBtn = document.getElementById('back-to-top');
  if (backToTopBtn) {
    window.addEventListener('scroll', () => {
      if (window.scrollY > 300) {
        backToTopBtn.classList.remove('opacity-0', 'pointer-events-none');
        backToTopBtn.classList.add('opacity-100');
      } else {
        backToTopBtn.classList.add('opacity-0', 'pointer-events-none');
        backToTopBtn.classList.remove('opacity-100');
      }
    });

    backToTopBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }
</script>
