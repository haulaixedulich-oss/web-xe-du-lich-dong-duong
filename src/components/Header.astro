---
import { siteInfo } from '../data/siteData.js';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navItems = [
  { name: 'Trang Chủ', href: '/' },
  { name: 'Dòng Xe 29 & 45 Chỗ', href: '/dong-xe' },
  { name: 'Tuyến Du Lịch Phía Bắc', href: '/tuyen-du-lich' },
  { name: 'Liên Hệ & Báo Giá', href: '/lien-he' },
];
---

<header class="sticky top-0 z-50 bg-white shadow-md">
  <!-- Topbar tiện ích -->
  <div class="bg-gradient-to-r from-red-950 via-red-900 to-red-800 text-white text-xs py-2 px-4 border-b border-red-800">
    <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-2">
      <div class="flex items-center gap-2 sm:gap-4 flex-wrap text-xs">
        <span class="flex items-center gap-1.5 text-red-200 whitespace-nowrap">
          <svg class="w-3.5 h-3.5 text-amber-400 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
          </svg>
          <span>Hà Nội • Sapa • Ninh Bình • Hạ Long • Hà Giang</span>
        </span>
        <span class="hidden md:inline text-red-400">|</span>
        <span class="hidden sm:flex items-center gap-1.5 text-amber-300 font-medium whitespace-nowrap">
          <span>Phục vụ khách đoàn:</span>
          <span class="inline-flex gap-1 items-center font-bold tracking-wider">
            🇹🇭 Thái • 🇫🇷 Pháp • 🇯🇵 Nhật • 🇰🇷 Hàn • 🇹🇼 Đài • 🇻🇳 Sài Gòn
          </span>
        </span>
      </div>

      <div class="flex items-center gap-3 text-xs font-semibold whitespace-nowrap ml-auto">
        <a href={siteInfo.hotlineFormatted} class="flex items-center gap-1.5 hover:text-amber-300 transition-colors">
          <svg class="w-3.5 h-3.5 text-amber-400 animate-pulse flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
            <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
          </svg>
          Hotline: <strong class="text-amber-300 text-sm font-black">{siteInfo.hotline}</strong>
        </a>
        <span class="text-red-400">|</span>
        <a href={siteInfo.zalo} target="_blank" rel="noopener" class="hover:text-amber-300 transition-colors">
          Zalo
        </a>
        <span class="text-red-400">|</span>
        <a href={siteInfo.whatsapp} target="_blank" rel="noopener" class="hover:text-amber-300 transition-colors">
          WhatsApp
        </a>
      </div>
    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20 gap-4">
      
      <!-- Brand Logo & Name: Hoàn toàn 1 dòng gọn gàng, không bị xuống dòng lộn xộn -->
      <a href="/" class="flex items-center gap-3 flex-shrink-0 py-2 group">
        <div class="relative w-12 h-12 sm:w-14 sm:h-14 flex-shrink-0 flex items-center justify-center p-1 bg-white rounded-xl shadow-sm border border-red-100 group-hover:border-red-300 transition-all">
          <img 
            src="/images/logo.png" 
            alt="Logo Nhà Xe Đông Dương - Đông Dương Travel" 
            class="w-full h-full object-contain" 
            loading="eager"
          />
        </div>
        <div class="flex flex-col justify-center">
          <div class="flex items-baseline gap-1.5 leading-none">
            <span class="text-xl sm:text-2xl font-black tracking-tight text-red-700 uppercase whitespace-nowrap">
              Đông Dương
            </span>
            <span class="text-sm sm:text-base font-bold text-amber-500 tracking-wider uppercase whitespace-nowrap">
              Travel
            </span>
          </div>
          <span class="text-xs font-semibold text-slate-700 mt-1 whitespace-nowrap tracking-tight">
            Xe Du Lịch 29 - 45 Chỗ Tuyến Phía Bắc
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Menu: whitespace-nowrap 100%, tuyệt đối không rớt chữ xuống dòng -->
      <nav class="hidden lg:flex items-center gap-1 xl:gap-2 flex-shrink-0">
        {navItems.map((item) => {
          const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
          return (
            <a
              href={item.href}
              class={isActive 
                ? 'px-3.5 py-2 rounded-lg text-sm font-bold whitespace-nowrap text-red-700 bg-red-50 border-b-2 border-red-600 transition-all'
                : 'px-3.5 py-2 rounded-lg text-sm font-semibold whitespace-nowrap text-slate-700 hover:text-red-600 hover:bg-slate-50 transition-all'}
            >
              {item.name}
            </a>
          );
        })}
      </nav>

      <!-- CTA Button: 1 dòng dứt khoát, không wrap -->
      <div class="flex items-center gap-3 flex-shrink-0">
        <a
          href="/lien-he"
          class="hidden sm:inline-flex items-center gap-2 bg-gradient-to-r from-red-600 to-red-700 hover:from-red-700 hover:to-red-800 text-white font-bold text-sm px-5 py-2.5 rounded-full shadow-luxury hover:shadow-luxury-lg transform hover:-translate-y-0.5 transition-all duration-200 whitespace-nowrap"
        >
          <svg class="w-4 h-4 text-amber-300 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
          </svg>
          <span class="whitespace-nowrap">Nhận Báo Giá Xe</span>
        </a>

        <!-- Mobile Menu Button -->
        <button
          id="mobile-menu-button"
          type="button"
          class="lg:hidden p-2 rounded-md text-slate-700 hover:text-red-600 hover:bg-red-50 focus:outline-none"
          aria-label="Mở menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path id="menu-icon-open" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            <path id="menu-icon-close" class="hidden" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-t border-slate-100 shadow-xl px-4 pt-3 pb-6 space-y-2">
    {navItems.map((item) => {
      const isActive = currentPath === item.href;
      return (
        <a
          href={item.href}
          class={isActive
            ? 'block px-4 py-3 rounded-lg text-base font-bold bg-red-50 text-red-700'
            : 'block px-4 py-3 rounded-lg text-base font-semibold text-slate-800 hover:bg-slate-50 hover:text-red-600'}
        >
          {item.name}
        </a>
      );
    })}
    <div class="pt-3 border-t border-slate-100 space-y-2">
      <a
        href="/lien-he"
        class="w-full flex justify-center items-center gap-2 bg-red-600 hover:bg-red-700 text-white font-bold py-3 rounded-xl shadow-md"
      >
        <span>Gửi Yêu Cầu Báo Giá</span>
      </a>
      <div class="text-center text-xs text-slate-500 py-1">
        Phục vụ chuyên nghiệp: 🇹🇭 Thái • 🇫🇷 Pháp • 🇯🇵 Nhật • 🇰🇷 Hàn • 🇹🇼 Đài Loan • 🇻🇳 Sài Gòn
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
