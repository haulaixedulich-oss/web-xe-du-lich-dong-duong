---
import { siteInfo, popularRoutes, fleetVehicles } from '../data/siteData.js';
---

<footer class="bg-slate-950 text-slate-300 pt-16 pb-12 border-t-4 border-red-700">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-slate-800">
      
      <!-- Cột 1: Thương hiệu Đông Dương Travel -->
      <div class="space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-12 h-12 bg-white p-1 rounded-lg flex items-center justify-center shadow-md flex-shrink-0">
            <img src="/images/logo.png" alt="Logo Đông Dương Travel" class="w-full h-full object-contain" />
          </div>
          <div>
            <span class="text-xl font-black text-white block uppercase tracking-tight">
              Đông Dương <span class="text-amber-500">Travel</span>
            </span>
            <span class="text-xs text-red-400 font-semibold tracking-wide block">
              Nhà Xe Du Lịch 29 - 45 Chỗ Miền Bắc
            </span>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed">
          Nhà xe Đông Dương chuyên cung cấp dịch vụ vận tải du lịch chất lượng cao dòng xe 29 chỗ & 45 chỗ đời mới tại Hà Nội và các tỉnh phía Bắc. Chuyên đón tiễn sân bay Nội Bài, phục vụ tour khách quốc tế và kết nối tin cậy cùng các đối tác lữ hành.
        </p>
        <div class="p-3 bg-red-950/50 border border-red-800/60 rounded-xl">
          <span class="text-xs font-bold text-amber-300 block mb-1">
            Thị Trường Phục Vụ Trọng Điểm:
          </span>
          <div class="flex flex-wrap gap-1.5 text-xs text-slate-300">
            <span class="bg-red-900/60 px-2 py-0.5 rounded">🇹🇭 Thái Lan</span>
            <span class="bg-red-900/60 px-2 py-0.5 rounded">🇫🇷 Pháp</span>
            <span class="bg-red-900/60 px-2 py-0.5 rounded">🇯🇵 Nhật Bản</span>
            <span class="bg-red-900/60 px-2 py-0.5 rounded">🇰🇷 Hàn Quốc</span>
            <span class="bg-red-900/60 px-2 py-0.5 rounded">🇹🇼 Đài Loan</span>
            <span class="bg-red-900/60 px-2 py-0.5 rounded">🇻🇳 Sài Gòn & Nội Địa</span>
          </div>
        </div>
      </div>

      <!-- Cột 2: Các dòng xe phục vụ -->
      <div class="space-y-4">
        <h4 class="text-base font-bold text-white uppercase tracking-wider border-l-4 border-red-600 pl-3">
          Đội Xe Du Lịch
        </h4>
        <ul class="space-y-3 text-sm">
          {fleetVehicles.map((v) => (
            <li>
              <a href="/dong-xe" class="group block hover:text-amber-300 transition-colors">
                <span class="font-semibold text-white group-hover:text-amber-300 block">
                  {v.name}
                </span>
                <span class="text-xs text-slate-400 block mt-0.5">
                  {v.models}
                </span>
                <span class="inline-block mt-1 text-[11px] bg-slate-900 text-red-400 px-2 py-0.5 rounded border border-slate-800">
                  {v.tag}
                </span>
              </a>
            </li>
          ))}
          <li class="pt-2 text-xs text-slate-400">
            ✓ 100% xe bầu hơi êm ái, máy lạnh sâu, khoang hành lý lớn, tài xế chuyên đèo núi phía Bắc.
          </li>
        </ul>
      </div>

      <!-- Cột 3: Tuyến du lịch phía Bắc -->
      <div class="space-y-4">
        <h4 class="text-base font-bold text-white uppercase tracking-wider border-l-4 border-red-600 pl-3">
          Tuyến Phía Bắc Chủ Lực
        </h4>
        <ul class="space-y-2.5 text-sm">
          {popularRoutes.slice(0, 5).map((route) => (
            <li>
              <a href="/tuyen-du-lich" class="hover:text-amber-300 transition-colors flex items-center gap-2 group text-xs sm:text-sm">
                <span class="text-red-500 group-hover:translate-x-0.5 transition-transform">›</span>
                <span>{route.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Cột 4: Liên hệ & Hợp tác Lữ hành -->
      <div class="space-y-4">
        <h4 class="text-base font-bold text-white uppercase tracking-wider border-l-4 border-red-600 pl-3">
          Liên Hệ & Đối Tác
        </h4>
        <ul class="space-y-3 text-xs sm:text-sm text-slate-300">
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-red-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 4V3z"></path>
            </svg>
            <div>
              <span class="block text-slate-400 text-xs">Hotline 24/7 Báo Giá Nhanh:</span>
              <a href={siteInfo.hotlineFormatted} class="text-base font-bold text-amber-300 hover:underline">
                {siteInfo.hotline}
              </a>
            </div>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-red-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
            </svg>
            <span>{siteInfo.garageAddress}</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="w-4 h-4 text-red-500 mt-1 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
            </svg>
            <span>{siteInfo.email}</span>
          </li>
          <li class="pt-2 flex items-center gap-3">
            <a href={siteInfo.zalo} target="_blank" rel="noopener" class="bg-blue-600 hover:bg-blue-700 text-white text-xs px-3 py-1.5 rounded-lg font-semibold transition-colors">
              Zalo Báo Giá
            </a>
            <a href={siteInfo.whatsapp} target="_blank" rel="noopener" class="bg-emerald-600 hover:bg-emerald-700 text-white text-xs px-3 py-1.5 rounded-lg font-semibold transition-colors">
              WhatsApp
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 flex flex-col sm:flex-row justify-between items-center text-xs text-slate-500 gap-3">
      <div>
        © 2024 - 2026 <strong>Nhà Xe Đông Dương (Đông Dương Travel)</strong>. All rights reserved.
      </div>
      <div class="flex items-center gap-4">
        <span>Tên miền chính thức: <strong class="text-slate-300">{siteInfo.domain}</strong></span>
        <span>•</span>
        <a href="/lien-he" class="hover:text-slate-300 transition-colors">Hợp Tác Đối Tác Lữ Hành</a>
      </div>
    </div>

  </div>
</footer>
